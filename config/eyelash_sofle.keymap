#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;     // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

// Layer-taps en A y F: evita activar la capa al escribir rápido ("for" -> "f'r").
// Solo se activa la capa si la otra tecla es de la mano derecha (o un pulgar derecho):
// rodar "fa", "df", "as" con la misma mano siempre da letras. Útil en Neovim (f, a, A...).
&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
    require-prior-idle-ms = <125>;
    hold-trigger-key-positions = <
         7  8  9 10 11 12
        20 21 22 23 24 25
        33 34 35 36 37 38
        46 47 48 49 50 51
        59 60 61 62 63
    >;
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    macros {
        // ñ en Windows con teclado English (US): Alt + 0241 en el keypad.
        // Requiere Num Lock ENCENDIDO: si está apagado, KP_N4 se vuelve "flecha izquierda"
        // y Alt+Izquierda hace "Atrás" en el navegador.
        enye: enye {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <30>;
            wait-ms = <20>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N4 &kp KP_N1>
                , <&macro_release &kp LALT>
                ;
        };
    };

    behaviors {
        // Tocar = n | mantener = ñ. Escribir "nn" rápido (o n n en Neovim) siempre da n.
        n_enye: n_enye {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&enye>, <&kp>;
        };
    };

    // Mantener MOVE (pulgar izq.) + SYMBOLS (pulgar der.) activa SYS: Bluetooth, salida, reset, bootloader.
    conditional_layers {
        compatible = "zmk,conditional-layers";

        sys {
            if-layers = <1 2>;
            then-layer = <5>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp TAB     &kp N1     &kp N2        &kp N3        &kp N4   &kp N5                                         &kp UP_ARROW                                        &kp N6            &kp N7     &kp N8     &kp N9           &kp N0      &kp BACKSPACE
&kp ESC     &kp Q      &kp W         &kp E         &kp R    &kp T                                          &kp DOWN_ARROW                                      &kp Y             &kp U      &kp I      &kp O            &kp P       &kp DELETE
&kp LSHFT   &lt 3 A    &kp S         &kp D         &lt 2 F  &kp G                                          &kp LC(LG(LEFT))                                     &kp H             &kp J      &kp K      &kp L            &kp SEMI    &kp MINUS
&kp LCTRL   &kp Z      &kp X         &kp C         &kp V    &kp B                                          &kp LC(LG(RIGHT))                                    &n_enye 0 N      &kp M      &kp COMMA  &kp DOT          &kp FSLH    &kp SINGLE_QUOTE
&kp C_MUTE  &kp LCTRL  &kp LEFT_GUI  &kp LEFT_ALT  &mo 1    &kp SPACE                                      &kp ENTER                                           &kp ENTER         &kp SPACE  &mo 2      &kp RIGHT_SHIFT  &to 4
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "GERX";
        };

        layer_1 {
            bindings = <
&kp GRAVE   &kp F1           &kp F2          &kp F3           &kp F4           &kp F5                    &mmv MOVE_UP                                         &kp F6           &kp F7           &kp F8          &kp F9            &kp F10           &trans
&kp LC(LS(ESC))  &kp GRAVE   &mkp LCLK       &mkp MCLK        &mkp RCLK        &kp PSCRN                 &mmv MOVE_DOWN                                       &kp HOME         &kp PG_DN        &kp PG_UP       &kp END           &kp MINUS         &kp EQUAL
&kp CAPS    &kp TILDE        &kp C_PREV      &kp C_PP         &kp C_NEXT       &kp LG(LS(S))             &mmv MOVE_LEFT                                       &kp LEFT_ARROW   &kp DOWN_ARROW   &kp UP_ARROW    &kp RIGHT_ARROW   &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&caps_word  &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI           &mmv MOVE_RIGHT                                      &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &kp INSERT      &kp F11           &kp F12           &trans
&kp C_MUTE  &trans           &trans          &trans           &trans           &trans                    &mkp LCLK                                            &trans           &trans           &trans          &trans            &trans
            >;

            display-name = "MOVE";
            sensor-bindings = <&scroll_encoder>;
        };

        // Misma distribución que la capa SYM del Dactyl.
        // Lado izq. con el pulgar derecho (mo 2); lado der. manteniendo F.
        layer_2 {
            bindings = <
&trans     &trans        &trans        &trans        &trans        &trans                           &mmv MOVE_UP                                       &trans      &trans      &trans      &trans      &trans      &trans
&trans     &kp EXCL      &kp AT        &kp HASH      &kp DOLLAR    &kp PERCENT                      &mmv MOVE_DOWN                                     &kp AMPS    &kp LBKT    &kp RBKT    &kp PIPE    &kp BSLH    &trans
&trans     &kp GRAVE     &kp SQT       &kp DQT       &kp UNDER     &kp PLUS                         &mmv MOVE_LEFT                                     &kp EQUAL   &kp LPAR    &kp RPAR    &kp MINUS   &kp SEMI    &trans
&trans     &kp TILDE     &kp QMARK     &kp COLON     &kp ASTRK     &kp CARET                        &mmv MOVE_RIGHT                                    &kp LT      &kp LBRC    &kp RBRC    &kp GT      &kp FSLH    &trans
&trans     &trans        &trans        &trans        &trans        &trans                           &mkp LCLK                                          &trans      &trans      &trans      &trans      &trans
            >;

            display-name = "SYMBOLS";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_3 {
            bindings = <
&trans      &trans     &trans        &trans        &trans             &trans                                    &kp UP_ARROW                                        &kp HASH        &kp PERCENT   &kp SLASH    &kp ASTERISK    &kp MINUS        &trans
&trans      &trans     &trans        &trans        &trans             &trans                                    &kp DOWN_ARROW                                      &trans          &kp N7        &kp N8       &kp N9          &kp PLUS         &trans
&trans      &trans     &trans        &trans        &trans             &trans                                    &kp LEFT_ARROW                                      &kp EQUAL       &kp N4        &kp N5       &kp N6          &trans           &trans
&trans      &trans     &trans        &trans        &trans             &trans                                    &kp RIGHT_ARROW                                     &trans          &kp N1        &kp N2       &kp N3          &kp N0           &kp DOT
&trans      &trans     &trans        &trans        &trans             &trans                                    &kp ENTER                                           &trans          &kp N0        &trans       &trans          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "NUMBERS";
        };

        layer_4 {
            bindings = <
&kp ESC     &trans     &trans        &trans        &trans         &trans                                   &kp DELETE                                          &trans            &trans     &trans     &trans           &trans      &trans
&trans      &trans     &trans        &trans        &trans         &trans                                   &kp I                                               &trans            &trans     &trans     &trans           &trans      &trans
&trans      &kp A      &trans        &trans        &kp F          &trans                                   &kp FSLH                                            &trans            &trans     &trans     &trans           &trans      &trans
&kp M       &trans     &trans        &trans        &trans         &trans                                   &kp O                                               &trans            &trans     &trans     &trans           &trans      &trans
&trans      &kp DOT    &kp HOME      &kp LEFT_ALT  &kp LC(LSHFT)  &kp LCTRL                                &trans                                              &trans            &trans     &trans     &trans           &to 0
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "NINJX";
        };

        layer_5 {
            bindings = <
&bootloader  &sys_reset    &trans        &trans        &trans        &trans                         &trans                                             &trans      &trans      &trans      &trans      &sys_reset  &bootloader
&trans       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                   &trans                                             &trans      &trans      &trans      &trans      &trans      &trans
&trans       &out OUT_USB  &out OUT_BLE  &trans        &trans        &trans                         &trans                                             &trans      &trans      &trans      &trans      &trans      &trans
&trans       &bt BT_CLR    &trans        &trans        &trans        &bt BT_CLR_ALL                 &trans                                             &trans      &trans      &trans      &trans      &trans      &trans
&trans       &trans        &trans        &trans        &trans        &trans                         &trans                                             &trans      &trans      &trans      &trans      &trans
            >;

            display-name = "SYS";
        };
    };
};
